                                            <Hyperlink Click="BpmAnalyzerLink_Click" Foreground="#6366f1">
                                                <Run Text="тут"/>
                                            </Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border x:Name="EditorStatusBox" Background="#1a1a1a" CornerRadius="8"
                                            Padding="16" Margin="0,0,0,20" Visibility="Collapsed">
