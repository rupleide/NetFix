                                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                                        Click="EditorExportBtn_Click">
                                                    <TextBlock Text="Экспорт ZIP"/>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
