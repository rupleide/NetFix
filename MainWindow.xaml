                                        Style="{StaticResource FlatBtn}" Foreground="#3b82f6"
                                        FontSize="12" Padding="0,4"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Click="LinkTgWs_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource ArrowUpRightIcon}" 
                                              Stroke="#3b82f6"
                                              StrokeThickness="2"
                                              
                                              Width="12" Height="12"
                                              Stretch="Uniform"
                                              Margin="0,0,6,0"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="tg-ws-proxy на GitHub" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Left"
                                        Style="{StaticResource FlatBtn}" Foreground="#3b82f6"
                                        FontSize="12" Padding="0,4"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Click="LinkNetFix_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource ArrowUpRightIcon}" 
                                              Stroke="#3b82f6"
                                              StrokeThickness="2"
                                              
                                              Width="12" Height="12"
                                              Stretch="Uniform"
                                              Margin="0,0,6,0"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="NetFix на GitHub" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Left"
                                        Style="{StaticResource FlatBtn}" Foreground="#3b82f6"
                                        FontSize="12" Padding="0,4"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Click="OpenTelegramChannel_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource ArrowUpRightIcon}" 
                                              Stroke="#3b82f6"
                                              StrokeThickness="2"
                                              
                                              Width="12" Height="12"
                                              Stretch="Uniform"
                                              Margin="0,0,6,0"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="Telegram-канал @NetFixRuBi" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Border Height="1" Background="#333333" Margin="0,16"/>
                                <TextBlock Text="РЕЗЕРВНОЕ КОПИРОВАНИЕ" FontFamily="Segoe UI" FontSize="11"
                                           Foreground="#888888" FontWeight="Bold" Margin="0,0,0,12"/>
                                
                                <Button Style="{StaticResource OutlineBtn}" HorizontalAlignment="Stretch"
                                        Padding="12,8" Margin="0,0,0,6"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Click="ExportSettings_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="📤" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Экспортировать результаты тестов" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button Style="{StaticResource OutlineBtn}" HorizontalAlignment="Stretch"
                                        Padding="12,8" Margin="0,0,0,16"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Click="ImportSettings_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="📥" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Импортировать результаты тестов" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                
                                <Border Height="1" Background="#333333" Margin="0,0,0,16"/>
                                <TextBlock Text="СБРОС" FontFamily="Segoe UI" FontSize="11"
                                           Foreground="#888888" FontWeight="Bold" Margin="0,0,0,12"/>
                                <Button Style="{StaticResource OutlineBtn}" HorizontalAlignment="Stretch"
                                        Padding="12,8" Margin="0,0,0,6" Foreground="#888888"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Click="ReOnboard_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Path Data="{StaticResource RefreshIcon}" 
                                              Fill="#888888"
                                              Width="14" Height="14"
                                              Stretch="Uniform"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="Пройти онбординг заново" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="Сбросить все настройки"
                                        Style="{StaticResource OutlineBtn}" HorizontalAlignment="Stretch"
                                        Padding="12,8" Foreground="#ef4444"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Click="ResetSettings_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ══════════════════ ZAPRET WIZARD OVERLAY ══════════════════ -->
            <Grid Grid.Row="0" Grid.RowSpan="3" x:Name="WizardLayer"
                  Visibility="Collapsed" Panel.ZIndex="15">
                <Rectangle x:Name="WizardBackdrop" Fill="Black" Opacity="0.6"/>
                <Border Width="370" HorizontalAlignment="Right"
                        Background="#1e1e1e" CornerRadius="0,12,12,0" BorderBrush="#333333" BorderThickness="1,0,0,0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="WizardTrans" X="370"/>
                    </Border.RenderTransform>
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Height="54" BorderBrush="#333333" BorderThickness="0,0,0,1">
                            <Grid Margin="20,0">
                                <TextBlock Text="Мастер настройки Zapret" FontFamily="Segoe UI" FontSize="15"
                                           FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                <Button HorizontalAlignment="Right"
                                        Style="{StaticResource FlatBtnCentered}" Padding="0" Width="34" Height="34"
                                        VerticalAlignment="Center"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Click="WizardCloseBtn_Click">
                                    <Path Data="{StaticResource CloseIcon}" 
                                          Stroke="#888888"
                                          StrokeThickness="2"
                                          
                                          Width="12" Height="12"
                                          Stretch="Uniform"/>
                                </Button>
                            </Grid>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="WizardContent" Margin="20,20,20,24">
                                <!-- Прогресс-бар для применения конфига -->
                                <ProgressBar x:Name="WizardApplyProgress"
                                             Height="3"
                                             Margin="0,0,0,8"
                                             IsIndeterminate="True"
                                             Visibility="Collapsed"
                                             Foreground="#3b82f6"
                                             Background="#1a1a1c"
                                             BorderThickness="0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ══════════════════ ONBOARDING OVERLAY ══════════════════ -->
            <Border Grid.Row="0" Grid.RowSpan="3" x:Name="OnboardLayer"
                  Visibility="Collapsed" Background="#161616" CornerRadius="12" ClipToBounds="True" Panel.ZIndex="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <!-- Content injected from code-behind -->
                    <ContentControl x:Name="OnboardContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </Grid>
            </Border>

            <!-- ══════════════════ SERVICES PANEL ══════════════════ -->
            <Grid Grid.Row="0" Grid.RowSpan="3" x:Name="ServicesLayer"
                  Visibility="Collapsed" Panel.ZIndex="14">
                <Rectangle Fill="Black" Opacity="0.4"
                           MouseLeftButtonDown="ServicesBackdrop_Click"/>
                <Border x:Name="ServicesPanel" Width="300"
                        HorizontalAlignment="Right"
                        Background="#1e1e1e" CornerRadius="0,12,12,0"
                        BorderBrush="#333333" BorderThickness="1,0,0,0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ServicesTrans" X="300"/>
                    </Border.RenderTransform>
                    <DockPanel>

                        <!-- Заголовок -->
                        <Border DockPanel.Dock="Top" Height="54"
                                BorderBrush="#333333" BorderThickness="0,0,0,1">
                            <Grid Margin="20,0">
                                <TextBlock Text="Управление сервисами"
                                           FontFamily="Segoe UI" FontSize="15"
                                           FontWeight="Bold" Foreground="White"
                                           VerticalAlignment="Center"/>
                                <Button HorizontalAlignment="Right"
                                        Style="{StaticResource FlatBtnCentered}"
                                        Padding="0" Width="34" Height="34"
                                        VerticalAlignment="Center"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Click="ServicesCloseBtn_Click">
                                    <Path Data="{StaticResource CloseIcon}" 
                                          Stroke="#888888"
                                          StrokeThickness="2"
                                          
                                          Width="12" Height="12"
                                          Stretch="Uniform"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Контент -->
                        <StackPanel Margin="20,20,20,24">

                            <!-- Zapret -->
                            <Border Background="#252525" CornerRadius="12"
                                    BorderBrush="#333333" BorderThickness="1"
                                    Padding="16,14" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="10"
                                                Background="#1a2a3a" Margin="0,0,12,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Z" FontFamily="Segoe UI"
                                                       FontSize="17" FontWeight="Bold"
                                                       Foreground="#3b82f6"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Zapret"
                                                       FontFamily="Segoe UI" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="White"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Ellipse x:Name="ZapretDot2" Width="6" Height="6"
                                                         Fill="#888888" VerticalAlignment="Center"
                                                         Margin="0,0,5,0"/>
                                                <TextBlock x:Name="ZapretStatusLbl"
                                                           Text="Не запущен"
                                                           FontFamily="Segoe UI" FontSize="11"
                                                           Foreground="#888888"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button x:Name="ZapretToggleBtn" Grid.Column="2"
                                                Style="{StaticResource AccentBtn}"
                                                Padding="12,7" FontSize="12"
                                                WindowChrome.IsHitTestVisibleInChrome="True"
                                                Click="ZapretToggle_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource PlayIcon}" 
                                                      Fill="White"
                                                      Width="12" Height="12"
                                                      Stretch="Uniform"
                                                      Margin="0,0,6,0"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock Text="Запустить" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    
                                    <!-- Прогресс-бар для переключения Zapret -->
                                    <ProgressBar x:Name="ZapretToggleProgress"
                                                 Height="3"
                                                 Margin="0,8,0,0"
                                                 IsIndeterminate="True"
                                                 Visibility="Collapsed"
                                                 Foreground="#3b82f6"
                                                 Background="#1a1a1c"
                                                 BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                            <!-- tg-ws-proxy -->
                            <Border Background="#252525" CornerRadius="12"
                                    BorderBrush="#333333" BorderThickness="1"
                                    Padding="16,14" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="10"
                                                Background="#1a2a3a" Margin="0,0,12,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="T" FontFamily="Segoe UI"
                                                       FontSize="17" FontWeight="Bold"
                                                       Foreground="#3b82f6"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="tg-ws-proxy"
                                                       FontFamily="Segoe UI" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="White"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Ellipse x:Name="TgWsDot2" Width="6" Height="6"
                                                         Fill="#888888" VerticalAlignment="Center"
                                                         Margin="0,0,5,0"/>
                                                <TextBlock x:Name="TgWsStatusLbl"
                                                           Text="Не запущен"
                                                           FontFamily="Segoe UI" FontSize="11"
                                                           Foreground="#888888"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button x:Name="TgWsToggleBtn" Grid.Column="2"
                                                Style="{StaticResource AccentBtn}"
                                                Padding="12,7" FontSize="12"
                                                WindowChrome.IsHitTestVisibleInChrome="True"
                                                Click="TgWsToggle_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource PlayIcon}" 
                                                      Fill="White"
                                                      Width="12" Height="12"
                                                      Stretch="Uniform"
                                                      Margin="0,0,6,0"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock Text="Запустить" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    
                                    <!-- Прогресс-бар для переключения TgWsProxy -->
                                    <ProgressBar x:Name="TgWsToggleProgress"
                                                 Height="3"
                                                 Margin="0,8,0,0"
                                                 IsIndeterminate="True"
                                                 Visibility="Collapsed"
                                                 Foreground="#3b82f6"
                                                 Background="#1a1a1c"
                                                 BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                            <!-- Zapret Config Buttons -->
                            <TextBlock Text="Настройка Zapret" 
                                       FontFamily="Segoe UI" FontSize="12"
                                       FontWeight="SemiBold" Foreground="#888888" 
                                       Margin="0,16,0,8"/>
                            
                            <!-- Selected Config Display -->
                            <TextBlock x:Name="SelectedConfigText"
                                       FontFamily="Segoe UI" FontSize="14"
                                       FontWeight="SemiBold" Foreground="#f0f0f0" 
                                       Margin="0,0,0,12"
                                       TextWrapping="Wrap"/>
                            
                            <!-- Select Config Button (теперь первая, с акцентным стилем) -->
                            <Button x:Name="SelectConfigBtn"
                                    Style="{StaticResource AccentBtn}"
                                    Padding="14,12"
                                    Margin="0,0,0,8"
                                    HorizontalContentAlignment="Left"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="SelectConfigBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource SettingsIcon}" 
                                          Fill="White"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Выбрать конфиг" 
                                               FontFamily="Segoe UI" FontSize="13"
                                               Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            
                            <!-- Test Configs Button (теперь вторая, с outline стилем) -->
                            <Button x:Name="TestConfigsBtn"
                                    Style="{StaticResource OutlineBtn}"
                                    Padding="14,12"
                                    Margin="0,0,0,8"
                                    HorizontalContentAlignment="Left"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="TestConfigsBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource SearchIcon}" 
                                          Stroke="#888888"
                                          StrokeThickness="1.5"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Начать сканирование" 
                                               FontFamily="Segoe UI" FontSize="13"
                                               Foreground="#888888" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Активный конфиг -->
                            <TextBlock x:Name="ActiveConfigText" 
                                       Margin="0,12,0,0"
                                       FontSize="12"
                                       Visibility="Collapsed">
                                <Run Text="Включен конфиг: " Foreground="#888888"/>
                                <Run x:Name="ActiveConfigName" Text="" Foreground="#22c55e"/>
                            </TextBlock>

                            <!-- Divider -->
                            <Border Height="1" Background="#2a2a2a" Margin="0,20,0,16"/>

                            <!-- Version Status Section -->
                            <StackPanel x:Name="VersionStatusSection">
                                <!-- Status Header -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Path x:Name="VersionStatusIcon"
                                          Width="18" Height="18"
                                          Stretch="Uniform"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock x:Name="VersionStatusTitle"
                                               FontFamily="Segoe UI" FontSize="14"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Zapret Version -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Zapret: " 
                                               FontFamily="Segoe UI" FontSize="13"
                                               Foreground="#cccccc"
                                               VerticalAlignment="Center"/>
                                    <StackPanel x:Name="ZapretVersionPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="ZapretVersionText"
                                                   FontFamily="Segoe UI" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <Path x:Name="ZapretVersionIcon"
                                              Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                              Fill="#22c55e"
                                              Width="14" Height="14"
                                              Stretch="Uniform"
                                              Margin="6,0,0,0"
                                              VerticalAlignment="Center"
                                              Visibility="Collapsed"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- TgWsProxy Version -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <TextBlock Text="TgWsProxy: " 
                                               FontFamily="Segoe UI" FontSize="13"
                                               Foreground="#cccccc"
                                               VerticalAlignment="Center"/>
                                    <StackPanel x:Name="TgWsProxyVersionPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TgWsProxyVersionText"
                                                   FontFamily="Segoe UI" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <Path x:Name="TgWsProxyVersionIcon"
                                              Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                              Fill="#22c55e"
                                              Width="14" Height="14"
                                              Stretch="Uniform"
                                              Margin="6,0,0,0"
                                              VerticalAlignment="Center"
                                              Visibility="Collapsed"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Update Components Button -->
                            <Button x:Name="UpdateComponentsBtn"
                                    Style="{StaticResource OutlineBtn}"
                                    Padding="14,12"
                                    Margin="0,16,0,0"
                                    HorizontalContentAlignment="Left"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="UpdateComponentsBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource RefreshIcon}" 
                                          Fill="#888888"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Обновить компоненты" 
                                               FontFamily="Segoe UI" FontSize="13"
                                               Foreground="#888888" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
