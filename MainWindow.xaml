                                        <StackPanel>
                                            <TextBlock Text="🔴 ЗАПИСЬ" FontFamily="Segoe UI" FontSize="12"
                                                       Foreground="#ef4444" FontWeight="Bold" HorizontalAlignment="Center"
                                                       Margin="0,0,0,12"/>
                                            <TextBlock x:Name="EditorNoteCount" Text="0 нот записано" FontFamily="Segoe UI"
                                                       FontSize="13" Foreground="#888" HorizontalAlignment="Center"
                                                       Margin="0,0,0,16"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Border x:Name="EditorKeyA" Background="#1a0a10" CornerRadius="6"
                                                        Padding="12,8" Margin="4,0" BorderBrush="#2a1020" BorderThickness="1.5">
                                                    <TextBlock Text="A  ◀" FontFamily="Segoe UI" FontSize="12" Foreground="#f43f5e"/>
                                                </Border>
                                                <Border x:Name="EditorKeyS" Background="#1a1400" CornerRadius="6"
                                                        Padding="12,8" Margin="4,0" BorderBrush="#2a2010" BorderThickness="1.5">
                                                    <TextBlock Text="S  ▼" FontFamily="Segoe UI" FontSize="12" Foreground="#f59e0b"/>
                                                </Border>
                                                <Border x:Name="EditorKeyK" Background="#001a08" CornerRadius="6"
                                                        Padding="12,8" Margin="4,0" BorderBrush="#0a2010" BorderThickness="1.5">
                                                    <TextBlock Text="K  ▲" FontFamily="Segoe UI" FontSize="12" Foreground="#22c55e"/>
                                                </Border>
                                                <Border x:Name="EditorKeyL" Background="#08001a" CornerRadius="6"
                                                        Padding="12,8" Margin="4,0" BorderBrush="#10102a" BorderThickness="1.5">
                                                    <TextBlock Text="L  ▶" FontFamily="Segoe UI" FontSize="12" Foreground="#6366f1"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#1a1a1a" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Path Data="{StaticResource BoltIcon}" 
                                                      Fill="#6366f1" Width="14" Height="14" 
                                                      Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Как создать уровень:" FontFamily="Segoe UI" FontSize="12" 
                                                           Foreground="#6366f1" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock FontFamily="Segoe UI" FontSize="11" Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,4">
                                                <Run Text="1."/>
                                                <Run Text=" Загрузите MP3 файл и укажите BPM трека"/>
                                            </TextBlock>
                                            <TextBlock FontFamily="Segoe UI" FontSize="11" Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,4">
                                                <Run Text="2."/>
                                                <Run Text=" Нажмите 'Начать запись' и слушайте трек"/>
                                            </TextBlock>
                                            <TextBlock FontFamily="Segoe UI" FontSize="11" Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,4">
                                                <Run Text="3."/>
                                                <Run Text=" Нажимайте WASD либо стрелочки в такт музыке"/>
                                            </TextBlock>
                                            <TextBlock FontFamily="Segoe UI" FontSize="11" Foreground="#666" TextWrapping="Wrap">
                                                <Run Text="4."/>
                                                <Run Text=" Завершите запись и нажмите сохранить - трек появится в пользовательской папке"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
