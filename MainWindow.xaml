                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="38"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="EditorTrackPath" Style="{StaticResource InputBox}"
                                                 Height="32" IsReadOnly="True" Padding="8,0"/>
                                        <Button Grid.Column="1" Content="…" Style="{StaticResource OutlineBtn}"
                                                Height="32" Padding="0" Margin="4,0,0,0"
                                                WindowChrome.IsHitTestVisibleInChrome="True"
                                                Click="EditorBrowseTrack_Click"/>
                                    </Grid>
                                    <TextBlock Text="Название трека" FontFamily="Segoe UI" FontSize="12"
                                               Foreground="#888" Margin="0,0,0,6"/>
                                    <TextBox x:Name="EditorTrackTitle" Style="{StaticResource InputBox}"
                                             Height="32" Padding="8,0" Margin="0,0,0,16"/>
                                    <TextBlock FontFamily="Segoe UI" FontSize="12" Foreground="#888888" Margin="0,0,0,6">
                                        <Run Text="Скорость игры (BPM) — "/>
                                        <Run Text="140 медленно, "/>
                                        <Run Text="200 средне, "/>
                                        <Run Text="240+ быстро"/>
                                    </TextBlock>
                                    <TextBox x:Name="EditorBpmBox" Style="{StaticResource InputBox}"
                                             Height="32" Padding="8,0" Margin="0,0,0,6"
                                             Text="140"/>
