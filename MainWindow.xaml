               <Grid.Resources>
                   <Style x:Key="TabRadio" TargetType="RadioButton">
                       <Setter Property="FontFamily" Value="Segoe UI"/>
                       <Setter Property="FontSize" Value="13"/>
                       <Setter Property="Cursor" Value="Hand"/>
                       <Setter Property="Padding" Value="20,0"/>
                       <Setter Property="Height" Value="42"/>
                       <Setter Property="Template">
                           <Setter.Value>
                               <ControlTemplate TargetType="RadioButton">
                                   <Grid>
                                       <Border x:Name="bg" Background="Transparent" CornerRadius="8" Margin="0,2"/>
                                       <TextBlock x:Name="tb" Text="{TemplateBinding Content}"
                                                  Foreground="#666669"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                       <Border x:Name="indicator" Height="2" VerticalAlignment="Bottom"
                                               Margin="12,0" Background="Transparent" CornerRadius="1"/>
                                   </Grid>
                                   <ControlTemplate.Triggers>
                                       <Trigger Property="IsChecked" Value="True">
                                           <Setter TargetName="bg" Property="Background" Value="#252529"/>
                                           <Setter TargetName="tb" Property="Foreground" Value="#93c5fd"/>
                                           <Setter TargetName="tb" Property="FontWeight" Value="SemiBold"/>
                                           <Setter TargetName="indicator" Property="Background" Value="#3b82f6"/>
                                       </Trigger>
                                       <Trigger Property="IsMouseOver" Value="True">
                                           <Setter TargetName="bg" Property="Background" Value="#1f1f23"/>
                                           <Setter TargetName="tb" Property="Foreground" Value="#aaaaaa"/>
                                       </Trigger>
                                   </ControlTemplate.Triggers>
                               </ControlTemplate>
                           </Setter.Value>
                       </Setter>
                   </Style>
                   <Style x:Key="ArrowBtn" TargetType="Button">
                       <Setter Property="Background" Value="#1c1c1e"/>
                       <Setter Property="BorderBrush" Value="#333333"/>
                       <Setter Property="BorderThickness" Value="1"/>
                       <Setter Property="Cursor" Value="Hand"/>
                       <Setter Property="Width" Value="40"/>
                       <Setter Property="Height" Value="40"/>
                       <Setter Property="Template">
                           <Setter.Value>
                               <ControlTemplate TargetType="Button">
                                   <Border x:Name="bd"
                                           Background="{TemplateBinding Background}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BorderThickness="{TemplateBinding BorderThickness}"
                                           CornerRadius="12">
                                       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                   </Border>
                                    <ControlTemplate.Triggers>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsEnabled" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="bd" Property="Background" Value="#1a2a3a"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#3b82f6"/>
                                        </MultiTrigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#172040"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                     <Style x:Key="HoverActionBtn" TargetType="Button">
                        <Setter Property="Background" Value="#1c1c1e"/>
                        <Setter Property="BorderBrush" Value="#22666666"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Width" Value="34"/>
                        <Setter Property="Height" Value="34"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#2a2a2e"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#44888888"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#1e1e22"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.55"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <PathGeometry x:Key="PlusIcon">M12,4 L12,20 M4,12 L20,12</PathGeometry>
                    <PathGeometry x:Key="ImportIcon">M4,16 L4,18 C4,19.1 4.9,20 6,20 L18,20 C19.1,20 20,19.1 20,18 L20,16 M12,4 L12,15 M8,11 L12,15 L16,11</PathGeometry>
                    <PathGeometry x:Key="ExportIcon">M4,16 L4,18 C4,19.1 4.9,20 6,20 L18,20 C19.1,20 20,19.1 20,18 L20,16 M12,15 L12,4 M8,8 L12,4 L16,8</PathGeometry>
                    <PathGeometry x:Key="TrashIcon">M3,6 L21,6 M8,6 L8,4 Q8,3 9,3 L15,3 Q16,3 16,4 L16,6 M10,11 L10,17 M14,11 L14,17 M5,6 L6,20 Q6,21 7,21 L17,21 Q18,21 18,20 L19,6</PathGeometry>
                    <PathGeometry x:Key="SearchIcon">M21,21 L15,15 M17,11 C17,14.3 14.3,17 11,17 C7.7,17 5,14.3 5,11 C5,7.7 7.7,5 11,5 C14.3,5 17,7.7 17,11 Z</PathGeometry>
                    <PathGeometry x:Key="RefreshIcon">M1,4 L1,10 L7,10 M23,20 L23,14 L17,14 M20.49,9 C19.53,6.13 16.9,4 13.72,4 C9.44,4 6,7.45 6,11.73 M3.51,15 C4.47,17.87 7.1,20 10.28,20 C14.56,20 18,16.55 18,12.27</PathGeometry>
                    <PathGeometry x:Key="GridIcon">M3,3 L10,3 L10,10 L3,10 Z M14,3 L21,3 L21,10 L14,10 Z M14,14 L21,14 L21,21 L14,21 Z M3,14 L10,14 L10,21 L14,21 Z</PathGeometry>
                    <PathGeometry x:Key="CheckmarkIconMods">M2,12 L8,18 L22,4</PathGeometry>
                    <PathGeometry x:Key="ArrowRightIcon">M5,12 L19,12 M13,6 L19,12 L13,18</PathGeometry>
                     <PathGeometry x:Key="CloseIconMods">M6,6 L18,18 M18,6 L6,18</PathGeometry>
                     <PathGeometry x:Key="FileAddIcon">M14,2 L6,2 C4.9,2 4,2.9 4,4 L4,20 C4,21.1 4.9,22 6,22 L18,22 C19.1,22 20,21.1 20,20 L20,8 L14,2 Z M14,2 L14,8 L20,8 M12,12 L12,18 M9,15 L15,15</PathGeometry>
                    <PathGeometry x:Key="FolderOpenIcon">M2,6 L2,20 C2,21.1 2.9,22 4,22 L20,22 C21.1,22 22,21.1 22,20 L22,8 C22,6.9 21.1,6 20,6 L12,6 L10,4 L4,4 C2.9,4 2,4.9 2,6 Z</PathGeometry>
                     <DataTemplate x:Key="ModCardTpl">
                        <Border MinHeight="90" Margin="0,2" CornerRadius="10"
                                Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" 
                                BorderThickness="1">
                            <Grid SizeChanged="OnModCardSizeChanged">
                                <Rectangle x:Name="BottomGlow" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                           Width="120" Height="90" Opacity="0.25"
                                           RenderOptions.EdgeMode="Aliased">
                                    <Rectangle.Fill>
                                        <RadialGradientBrush ColorInterpolationMode="ScRgbLinearInterpolation"
                                                             Center="0.0,1.0" GradientOrigin="0.0,1.0"
                                                             RadiusX="0.6" RadiusY="0.5">
                                            <GradientStop Color="#3b82f6" Offset="0.0"/>
                                            <GradientStop Color="#00000000" Offset="1.0"/>
                                        </RadialGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle x:Name="TopGlow" HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Width="120" Height="90" Opacity="0.15"
                                           RenderOptions.EdgeMode="Aliased">
                                    <Rectangle.Fill>
                                        <RadialGradientBrush ColorInterpolationMode="ScRgbLinearInterpolation"
                                                             Center="1.0,0.0" GradientOrigin="1.0,0.0"
                                                             RadiusX="0.6" RadiusY="0.5">
                                            <GradientStop Color="#3b82f6" Offset="0.0"/>
                                            <GradientStop Color="#00000000" Offset="1.0"/>
                                        </RadialGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle IsHitTestVisible="False" Opacity="0.04"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor">
                                    <Rectangle.Fill>
                                        <ImageBrush ImageSource="Assets/noise.png"
                                                    TileMode="Tile" ViewportUnits="Absolute"
                                                    Viewport="0,0,512,512" Stretch="None"/>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Grid Margin="12,10,10,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="StatusStrip" Grid.Column="0" Width="3" CornerRadius="1.5"
                                            Background="{StaticResource AccentBrush}" Margin="0,4,10,4"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top" MaxWidth="280">
                                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border CornerRadius="4" Background="#1e1e22" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock x:Name="CardAuthor" FontFamily="Segoe UI" FontSize="10" Foreground="#5a9fd4">
                                                    <Run Text="Автор: " FontWeight="SemiBold"/>
                                                    <Run Text="{Binding Author}"/>
                                                </TextBlock>
                                            </Border>
                                            <Border CornerRadius="4" Background="#1a1a1e" Padding="6,2">
                                                <TextBlock FontFamily="Segoe UI" FontSize="10" Foreground="{StaticResource DimTextBrush}"
                                                           Text="{Binding Version}"/>
                                            </Border>
                                            <Border CornerRadius="4" Background="#16161a" Padding="6,2" Margin="6,0,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSourceFileName}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontFamily="Consolas" FontSize="9" Foreground="#6b7280"
                                                           Text="{Binding SourceFileName}"/>
                                            </Border>
                                        </StackPanel>
                                        <Border Height="1" Background="#2a2a2d" Margin="0,6,0,4"/>
                                        <TextBlock Text="{Binding Description}" FontFamily="Segoe UI" FontSize="10.5"
                                                   Foreground="#999999" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                                    </StackPanel>
                                 </Grid>
                                 <Border x:Name="editOverlay" Background="#aa111113" CornerRadius="10"
                                         Visibility="Collapsed" IsHitTestVisible="False" Opacity="0"/>
                                 <StackPanel x:Name="hoverActions" Orientation="Horizontal"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Visibility="Collapsed" IsHitTestVisible="True"
                                             Margin="0,10,0,0" Opacity="0">
                                     <Button x:Name="CardMoveBtn" Style="{StaticResource HoverActionBtn}"
                                             Tag="{Binding}" Click="CardToggleActive_Click"
                                             ToolTip="В активные">
                                         <Grid>
                                             <Path x:Name="MoveArrowRight" Data="{StaticResource ArrowRightIcon}"
                                                   Stroke="#cccccc" StrokeThickness="1.8"
                                                   Width="16" Height="16" Stretch="Uniform"/>
                                             <Path x:Name="MoveArrowLeft" Data="{StaticResource ArrowLeftIcon}"
                                                   Stroke="#cccccc" StrokeThickness="1.8"
                                                   Width="16" Height="16" Stretch="Uniform"
                                                   Visibility="Collapsed"/>
                                         </Grid>
                                     </Button>
                                     <Button Style="{StaticResource HoverActionBtn}" Margin="6,0,0,0"
                                             Tag="{Binding}" Click="EditModCard_Click"
                                             ToolTip="Открыть">
                                         <Path Data="{StaticResource FolderOpenIcon}" Stroke="#cccccc" StrokeThickness="1.5"
                                               Width="16" Height="16" Stretch="Uniform"/>
                                     </Button>
                                     <Button Style="{StaticResource HoverActionBtn}" Margin="6,0,0,0"
                                             Tag="{Binding}" Click="ExportSingleMod_Click"
                                             ToolTip="Экспортировать">
                                         <Path Data="{StaticResource ExportIcon}" Stroke="#cccccc" StrokeThickness="1.5"
                                               Width="16" Height="16" Stretch="Uniform"/>
                                     </Button>
                                     <Button Style="{StaticResource HoverActionBtn}" Margin="6,0,0,0"
                                             Tag="{Binding}" Click="DeleteModCard_Click"
                                             ToolTip="Удалить">
                                         <Path Data="{StaticResource TrashIcon}" Stroke="#ef4444" StrokeThickness="1.5"
                                               Width="16" Height="16" Stretch="Uniform"/>
                                     </Button>
                                 </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                             <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                 <DataTrigger.EnterActions>
                                     <BeginStoryboard>
                                         <Storyboard>
                                             <DoubleAnimation Storyboard.TargetName="hoverActions"
                                                              Storyboard.TargetProperty="Opacity"
                                                              Duration="0:0:0.2" From="0" To="1">
                                                 <DoubleAnimation.EasingFunction>
                                                     <QuadraticEase EasingMode="EaseOut"/>
                                                 </DoubleAnimation.EasingFunction>
                                             </DoubleAnimation>
                                             <DoubleAnimation Storyboard.TargetName="editOverlay"
                                                              Storyboard.TargetProperty="Opacity"
                                                              Duration="0:0:0.2" From="0" To="1">
                                                 <DoubleAnimation.EasingFunction>
                                                     <QuadraticEase EasingMode="EaseOut"/>
                                                 </DoubleAnimation.EasingFunction>
                                             </DoubleAnimation>
                                         </Storyboard>
                                     </BeginStoryboard>
                                 </DataTrigger.EnterActions>
                                 <Setter TargetName="editOverlay" Property="Visibility" Value="Visible"/>
                                 <Setter TargetName="hoverActions" Property="Visibility" Value="Visible"/>
                             </DataTrigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="StatusStrip" Property="Background" Value="#22c55e"/>
                                <Setter TargetName="BottomGlow" Property="Fill">
                                    <Setter.Value>
                                        <RadialGradientBrush ColorInterpolationMode="ScRgbLinearInterpolation"
                                                             Center="0.0,1.0" GradientOrigin="0.0,1.0"
                                                             RadiusX="0.6" RadiusY="0.5">
                                            <GradientStop Color="#22c55e" Offset="0.0"/>
                                            <GradientStop Color="#00000000" Offset="1.0"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                 </Setter>
                                <Setter TargetName="TopGlow" Property="Fill">
                                    <Setter.Value>
                                        <RadialGradientBrush ColorInterpolationMode="ScRgbLinearInterpolation"
                                                             Center="1.0,0.0" GradientOrigin="1.0,0.0"
                                                             RadiusX="0.6" RadiusY="0.5">
                                            <GradientStop Color="#22c55e" Offset="0.0"/>
                                            <GradientStop Color="#00000000" Offset="1.0"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                 <Setter TargetName="CardAuthor" Property="Foreground" Value="#22c55e"/>
                                <Setter TargetName="MoveArrowRight" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="MoveArrowLeft" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CardMoveBtn" Property="ToolTip" Value="В доступные"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                     </DataTemplate>
                    <DataTemplate x:Key="MyModCardTpl">
                        <Border Width="160" Height="170" CornerRadius="14"
                                Background="#1a1a1e" BorderBrush="#2a2a2e" BorderThickness="1"
                                Margin="0,0,14,14" Padding="16,14,10,10"
                                Cursor="Hand" MouseLeftButtonUp="MyModCard_Click">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Height="3" CornerRadius="1.5"
                                        Background="#a855f7" Margin="0,0,0,12"
                                        HorizontalAlignment="Stretch"/>
                                <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="14"
                                           FontWeight="SemiBold" Foreground="#f0f0f0"
                                           TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                           MaxHeight="50" Margin="0,0,0,8"/>
                                <StackPanel Grid.Row="2">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border CornerRadius="4" Background="#1e1e22" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Author}" FontSize="10" Foreground="#5a9fd4"/>
                                        </Border>
                                        <Border CornerRadius="4" Background="#1a1a1e" Padding="6,2">
                                            <TextBlock Text="{Binding Version}" FontSize="10" Foreground="#555558"/>
                                        </Border>
                                        <Border CornerRadius="4" Background="#141418" Padding="6,2" Margin="6,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSourceFileName}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding SourceFileName}" FontSize="9" FontFamily="Consolas" Foreground="#6b7280"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource FlatBtn}" Width="24" Height="24" Padding="0"
                                                Tag="{Binding}" Click="ExportSingleMod_Click">
                                            <Path Data="{StaticResource ExportIcon}" Stroke="#777777" StrokeThickness="1.5"
                                                  Width="10" Height="10" Stretch="Uniform"/>
                                        </Button>
                                        <Button Style="{StaticResource FlatBtn}" Width="24" Height="24" Padding="0" Margin="6,0,0,0"
                                                Tag="{Binding}" Click="DeleteModCard_Click">
                                            <Path Data="{StaticResource CloseIcon}" Stroke="#ef4444" StrokeThickness="1.5"
                                                  Width="10" Height="10" Stretch="Uniform"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                    <Style x:Key="ModListBox" TargetType="ListBox">
                        <Setter Property="Background" Value="#30111113"/>
                       <Setter Property="BorderBrush" Value="#22222a"/>
                       <Setter Property="BorderThickness" Value="1"/>
                       <Setter Property="Padding" Value="6"/>
                        <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
                        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                        <Setter Property="AllowDrop" Value="True"/>
                       <Setter Property="ItemTemplate" Value="{StaticResource ModCardTpl}"/>
                       <Setter Property="ItemContainerStyle">
                           <Setter.Value>
                               <Style TargetType="ListBoxItem">
                                   <Setter Property="Background" Value="Transparent"/>
                                   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                   <Setter Property="Padding" Value="0"/>
                                   <Setter Property="BorderThickness" Value="0"/>
                                   <Setter Property="Template">
                                       <Setter.Value>
                                           <ControlTemplate TargetType="ListBoxItem">
                                               <Border x:Name="bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                                   <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                               </Border>
                                            <ControlTemplate.Triggers>
                                                </ControlTemplate.Triggers>
                                           </ControlTemplate>
                                       </Setter.Value>
                                   </Setter>
                               </Style>
                           </Setter.Value>
                       </Setter>
                       <Setter Property="Template">
                           <Setter.Value>
                               <ControlTemplate TargetType="ListBox">
                                   <Border CornerRadius="12" BorderBrush="{TemplateBinding BorderBrush}"
                                           BorderThickness="{TemplateBinding BorderThickness}"
                                           Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                                                      VerticalScrollBarVisibility="Hidden"
                                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}">
                                           <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                       </ScrollViewer>
                                   </Border>
                               </ControlTemplate>
                           </Setter.Value>
