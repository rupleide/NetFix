                                    </Border>
                                    <Border Background="#1a1400" CornerRadius="6" Padding="12,6" Margin="4,0">
                                        <TextBlock x:Name="KeyHint1" Text="S / ↓" FontFamily="Segoe UI" FontSize="12" Foreground="#f59e0b"/>
                                    </Border>
                                    <Border Background="#001a08" CornerRadius="6" Padding="12,6" Margin="4,0">
                                        <TextBlock x:Name="KeyHint2" Text="W / ↑" FontFamily="Segoe UI" FontSize="12" Foreground="#22c55e"/>
                                    </Border>
                                    <Border Background="#08001a" CornerRadius="6" Padding="12,6" Margin="4,0">
