<Window x:Class="NetFix.Views.HostsInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hosts-файлы - информация"
        Height="620" Width="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Window.Resources>
        <PathGeometry x:Key="HostsIcon">M12,2 C9.24,2 7,4.24 7,7 L7,10 L5,10 L5,22 L19,22 L19,10 L17,10 L17,7 C17,4.24 14.76,2 12,2 Z M12,4 C13.65,4 15,5.35 15,7 L15,10 L9,10 L9,7 C9,5.35 10.35,4 12,4 Z M12,14 C12.83,14 13.5,14.67 13.5,15.5 C13.5,16.06 13.18,16.54 12.71,16.79 L13,18 L11,18 L11.29,16.79 C10.82,16.54 10.5,16.06 10.5,15.5 C10.5,14.67 11.17,14 12,14 Z</PathGeometry>
        <PathGeometry x:Key="CloseIcon">M6,6 L18,18 M18,6 L6,18</PathGeometry>

        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="BorderBrush"  Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"   Value="#888888"/>
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Padding"      Value="12,6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatBtnCentered" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent"
                                CornerRadius="8"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2e2e2e"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#ef4444"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#b91c1c"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="Background"   Value="#3b82f6"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Padding"      Value="20,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#3b82f6" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2563eb"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#3a3a3a" CornerRadius="4" Width="4" HorizontalAlignment="Right" Margin="0,4,12,4"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,14,0,8"/>
        </Style>

        <Style x:Key="CodeBlock" TargetType="Border">
            <Setter Property="Background" Value="#1a1a1c"/>
            <Setter Property="BorderBrush" Value="#2a2a2d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8,12,8"/>
            <Setter Property="Margin" Value="0,6,0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border Background="#161618" CornerRadius="14" BorderBrush="#2a2a2d" BorderThickness="1" ClipToBounds="True">
        <Grid x:Name="RootGrid" SizeChanged="RootGrid_SizeChanged" Margin="1,1,-1,-1">
        <Rectangle Opacity="0.3" RenderOptions.EdgeMode="Aliased">
            <Rectangle.Fill>
                <RadialGradientBrush ColorInterpolationMode="ScRgbLinearInterpolation"
                                     Center="0.5,1.0" GradientOrigin="0.5,1.0"
                                     RadiusX="0.55" RadiusY="0.45">
                    <GradientStop Color="#506366f1" Offset="0.000"/>
                    <GradientStop Color="#006366f1" Offset="1.000"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Opacity="0.25" RenderOptions.EdgeMode="Aliased">
            <Rectangle.Fill>
                <RadialGradientBrush ColorInterpolationMode="ScRgbLinearInterpolation"
                                     Center="0.1,0.1" GradientOrigin="0.1,0.1"
                                     RadiusX="0.35" RadiusY="0.30">
                    <GradientStop Color="#308B5CF6" Offset="0.000"/>
                    <GradientStop Color="#008B5CF6" Offset="1.000"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Opacity="0.15" RenderOptions.EdgeMode="Aliased">
            <Rectangle.Fill>
                <RadialGradientBrush ColorInterpolationMode="ScRgbLinearInterpolation"
                                     Center="0.9,0.8" GradientOrigin="0.9,0.8"
                                     RadiusX="0.30" RadiusY="0.25">
                    <GradientStop Color="#284F46E5" Offset="0.000"/>
                    <GradientStop Color="#004F46E5" Offset="1.000"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle IsHitTestVisible="False" Opacity="0.04"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   RenderOptions.EdgeMode="Aliased">
            <Rectangle.Fill>
                <ImageBrush ImageSource="pack://application:,,,/Assets/noise.png"
                            TileMode="Tile" ViewportUnits="Absolute"
                            Viewport="0,0,512,512" Stretch="None"/>
            </Rectangle.Fill>
        </Rectangle>

        <Grid x:Name="ContentGrid" Margin="1,1,-1,-1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="71"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto" MinHeight="69"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="28,14,28,10"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown"
                  Cursor="SizeAll">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#1e1e22" Margin="0,0,12,0">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              VerticalAlignment="Center" HorizontalAlignment="Center"
                              Data="{StaticResource HostsIcon}"
                              Fill="#3b82f6"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Системный файл" FontSize="11" Foreground="#555558" FontWeight="Medium"/>
                        <TextBlock Text="Hosts-файлы" FontSize="15" FontWeight="SemiBold" Foreground="#f0f0f0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource FlatBtnCentered}"
                            Width="34" Height="18.62" MinWidth="34" MinHeight="18.62" Padding="0,0,0,1" FontSize="14"
                            Click="MinBtn_Click">
                        <TextBlock Text="&#x2212;" Margin="0,-1,0,0"/>
                    </Button>
                    <Button Style="{StaticResource CloseBtn}"
                            Width="34" Height="18.62" Padding="0" Margin="-6,0,0,0"
                            Click="CloseBtn_Click">
                        <Path Data="{StaticResource CloseIcon}"
                              Stroke="#888888"
                              StrokeThickness="2"
                              Width="12" Height="12"
                              Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
            <Border Grid.Row="0" Height="1" Background="#22222a" Margin="28,68,28,0" VerticalAlignment="Top"/>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="28,16,28,0">
                <StackPanel>

                    <TextBlock FontFamily="Segoe UI" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                               Foreground="#bbbbbb" Margin="0,0,0,12">
                        <Run xml:space="preserve">Этот раздел критически важен для </Run><Run FontWeight="Bold" Foreground="White">разблокировки популярных нейросетей и сервисов</Run><Run xml:space="preserve"> (</Run><Run FontWeight="Bold" Foreground="White">ChatGPT, Gemini, Grok</Run><Run xml:space="preserve"> и многих других) напрямую, без потери скорости.</Run>
                    </TextBlock>

                    <Border Height="1" Background="#22222a" Margin="0,6,0,6"/>

                    <TextBlock Text="&#x1F4A1;  Как это работает?" Style="{StaticResource SectionHeader}"/>
                    <TextBlock FontFamily="Segoe UI" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                               Foreground="#bbbbbb" Margin="0,0,0,8">
                        <Run xml:space="preserve">Активация hosts-модов автоматически добавляет правила в системный файл Windows. Запросы к заблокированным доменам перенаправляются на </Run><Run FontWeight="Bold" Foreground="White">альтернативные, рабочие IP-адреса</Run><Run xml:space="preserve"> (обратные прокси), минуя стандартные блокировки.</Run>
                    </TextBlock>

                    <Border Height="1" Background="#22222a" Margin="0,6,0,6"/>

                    <TextBlock Text="&#x26A0;&#xFE0F;  Почему моды могут не работать?" Style="{StaticResource SectionHeader}"/>

                    <TextBlock FontFamily="Segoe UI" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                               Foreground="#bbbbbb" Margin="0,0,0,8">
                        <Run Foreground="#555558">-</Run><Run xml:space="preserve"> </Run><Run FontWeight="Bold" Foreground="White">Права доступа:</Run><Run xml:space="preserve"> Приложение обязательно должно быть запущено </Run><Run FontWeight="Bold" Foreground="#ef4444">от имени Администратора</Run><Run>, иначе Windows просто не разрешит изменить системный файл.</Run>
                    </TextBlock>

                    <TextBlock FontFamily="Segoe UI" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                               Foreground="#bbbbbb" Margin="0,0,0,8">
                        <Run Foreground="#555558">-</Run><Run xml:space="preserve"> </Run><Run FontWeight="Bold" Foreground="White">Блокировка провайдером:</Run><Run xml:space="preserve"> Ваш провайдер может блокировать трафик по IP-адресу или использовать </Run><Run FontWeight="Bold" Foreground="White">DPI</Run><Run xml:space="preserve">. В таком случае нужно комбинировать hosts-мод с другими инструментами обхода.</Run>
                    </TextBlock>

                    <TextBlock FontFamily="Segoe UI" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                               Foreground="#bbbbbb" Margin="0,0,0,8">
                        <Run Foreground="#555558">-</Run><Run xml:space="preserve"> </Run><Run FontWeight="Bold" Foreground="White">Защита системы:</Run><Run xml:space="preserve"> Антивирусы или </Run><Run FontWeight="Bold" Foreground="White">Windows Defender</Run><Run xml:space="preserve"> часто блокируют изменения файла hosts, считая это действием вируса. Временно </Run><Run FontWeight="Bold" Foreground="#f59e0b">отключите защиту</Run><Run xml:space="preserve"> или добавьте приложение в исключения.</Run>
                    </TextBlock>

                    <TextBlock FontFamily="Segoe UI" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                               Foreground="#bbbbbb" Margin="0,0,0,8">
                        <Run Foreground="#555558">-</Run><Run xml:space="preserve"> </Run><Run FontWeight="Bold" Foreground="White">Кэш браузера (Важно):</Run><Run xml:space="preserve"> После применения мода </Run><Run FontWeight="Bold" Foreground="White">обязательно перезагрузите браузер</Run><Run xml:space="preserve">. Ещё лучше - полностью очистить DNS-кэш.</Run>
                    </TextBlock>

                    <TextBlock FontFamily="Segoe UI" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                               Foreground="#bbbbbb" Margin="0,0,0,8">
                        <Run Foreground="#555558">-</Run><Run xml:space="preserve"> </Run><Run FontWeight="Bold" Foreground="White">Динамические IP:</Run><Run xml:space="preserve"> Рабочие адреса платформ периодически меняются, из-за чего </Run><Run FontWeight="Bold" Foreground="White">старые моды теряют актуальность</Run><Run>.</Run>
                    </TextBlock>

                    <Border Height="1" Background="#22222a" Margin="0,6,0,6"/>

                    <TextBlock Text="&#x1F680;  Полезные советы" Style="{StaticResource SectionHeader}"/>

                    <TextBlock FontFamily="Segoe UI" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                               Foreground="#bbbbbb" Margin="0,0,0,4">
                        <Run Foreground="#555558">-</Run><Run xml:space="preserve"> </Run><Run FontWeight="Bold" Foreground="White">Очистка DNS-кэша:</Run><Run xml:space="preserve"> Если после применения мода ничего не изменилось - выполните в cmd от админа:</Run>
                    </TextBlock>

                    <Border x:Name="CodeBorder" Style="{StaticResource CodeBlock}"
                            MouseLeftButtonDown="CodeBorder_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="ipconfig /flushdns"
                                       FontFamily="Consolas" FontSize="13"
                                       Foreground="#ef4444"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="(нажмите для запуска cmd)"
                                       FontFamily="Segoe UI" FontSize="10"
                                       Foreground="#666669"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <TextBlock FontFamily="Segoe UI" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                               Foreground="#bbbbbb" Margin="0,0,0,8">
                        <Run Foreground="#555558">-</Run><Run xml:space="preserve"> </Run><Run FontWeight="Bold" Foreground="White">Режим Инкогнито:</Run><Run xml:space="preserve"> Проверяйте работу сервисов в режиме инкогнито - это исключит влияние старых cookies и кэша браузера.</Run>
                    </TextBlock>

                    <TextBlock FontFamily="Segoe UI" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                               Foreground="#bbbbbb" Margin="0,0,0,8">
                        <Run Foreground="#555558">-</Run><Run xml:space="preserve"> </Run><Run FontWeight="Bold" Foreground="White">Следите за обновлениями:</Run><Run xml:space="preserve"> Свежие моды вы можете найти в моём Telegram-канале </Run><Run FontWeight="Bold" Foreground="White">NetFix</Run><Run xml:space="preserve">, либо собрать собственный.</Run>
                    </TextBlock>

                    <Border Height="1" Background="#22222a" Margin="0,6,0,6"/>

                    <TextBlock Text="&#x1F310;  Полезные ссылки и готовые DNS" Style="{StaticResource SectionHeader}"/>

                    <TextBlock FontFamily="Segoe UI" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                               Foreground="#bbbbbb" Margin="0,0,0,8">
                        <Run>Если нужны полностью готовые решения - готовые адреса и правила:</Run>
                    </TextBlock>

                    <TextBlock FontFamily="Segoe UI" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                               Foreground="#bbbbbb" Margin="0,0,0,6">
                        <Run Foreground="#555558">-</Run><Run xml:space="preserve"> </Run>
                        <Hyperlink x:Name="Link1" NavigateUri="https://info.dns.malw.link/hosts"
                                   Foreground="#3b82f6" FontWeight="SemiBold"
                                   RequestNavigate="Hyperlink_RequestNavigate">
                            dns.malw.link/hosts
                        </Hyperlink>
                        <Run xml:space="preserve"> - готовые списки и правила для hosts.</Run>
                    </TextBlock>

                    <TextBlock FontFamily="Segoe UI" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                               Foreground="#bbbbbb" Margin="0,0,0,16">
                        <Run Foreground="#555558">-</Run><Run xml:space="preserve"> </Run>
                        <Hyperlink x:Name="Link2" NavigateUri="https://dns.geohide.ru:8443/"
                                   Foreground="#3b82f6" FontWeight="SemiBold"
                                   RequestNavigate="Hyperlink_RequestNavigate">
                            Зеркало Geohide DNS
                        </Hyperlink>
                        <Run xml:space="preserve"> - рабочие адреса для настройки обхода.</Run>
                    </TextBlock>

                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#1a1a1c" CornerRadius="0,0,14,14"
                    BorderBrush="#333338" BorderThickness="0,1,0,0"
                    Margin="0,16,0,0" Padding="28,12,28,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text=""
                               Foreground="#555558"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <Button Grid.Column="1" Content="Понятно"
                            MinWidth="130" MinHeight="36"
                            Style="{StaticResource AccentBtn}"
                            Click="OkBtn_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Border>
</Window>
