<Window x:Class="NetFix.Views.CreateModWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создать мод"
        Height="560" Width="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <PathGeometry x:Key="PlusIcon">M12,2 L12,22 M2,12 L22,12</PathGeometry>
        <PathGeometry x:Key="CloseIcon">M6,6 L18,18 M18,6 L6,18</PathGeometry>

        <!-- Flat button (base) -->
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="BorderBrush"  Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"   Value="#888888"/>
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Padding"      Value="12,6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent button (синяя, для основного действия) -->
        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="Background"   Value="#3b82f6"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Padding"      Value="20,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#3b82f6" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2563eb"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat button centered (minimize) -->
        <Style x:Key="FlatBtnCentered" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent"
                                CornerRadius="8"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2e2e2e"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close button -->
        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#ef4444"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#b91c1c"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outline button -->
        <Style x:Key="OutlineBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent"
                                BorderBrush="#333333" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#252525"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#3a3a3a" CornerRadius="4" Width="4" HorizontalAlignment="Right" Margin="0,4,12,4"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Field label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Input text box -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1a1a1c"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="CaretBrush" Value="#3b82f6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2a2a2d"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="SelectionBrush" Value="#3b82f6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalScrollBarVisibility="Auto"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Основной фон -->
    <Border Background="#161618" CornerRadius="14" BorderBrush="#2a2a2d" BorderThickness="1" ClipToBounds="True">
        <Grid x:Name="RootGrid" Margin="1,1,-1,-1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="71"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto" MinHeight="69"/>
            </Grid.RowDefinitions>

            <!-- ═══ HEADER ═══ -->
            <Grid Grid.Row="0" Margin="28,14,28,10"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown"
                  Cursor="SizeAll">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#1e1e22" Margin="0,0,12,0">
                        <Path Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                              Data="{StaticResource PlusIcon}" Stroke="#3b82f6" StrokeThickness="2"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SubtitleText" Text="Новый мод" FontSize="11" Foreground="#555558" FontWeight="Medium"/>
                        <TextBlock Text="Создать мод" FontSize="15" FontWeight="SemiBold" Foreground="#f0f0f0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource FlatBtnCentered}"
                            Width="34" Height="18.62" MinWidth="34" MinHeight="18.62" Padding="0,0,0,1" FontSize="14"
                            Click="MinBtn_Click">
                        <TextBlock Text="&#x2212;" Margin="0,-1,0,0"/>
                    </Button>
                    <Button Style="{StaticResource CloseBtn}"
                            Width="34" Height="18.62" Padding="0" Margin="-6,0,0,0"
                            Click="CloseBtn_Click">
                        <Path Data="{StaticResource CloseIcon}"
                              Stroke="#888888"
                              StrokeThickness="2"
                              Width="12" Height="12"
                              Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Разделитель -->
            <Border Grid.Row="0" Height="1" Background="#22222a" Margin="28,68,28,0" VerticalAlignment="Top"/>

            <!-- ═══ CONTENT ═══ -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="28,16,28,0">
                <StackPanel>

                    <!-- Название -->
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="НАЗВАНИЕ" Style="{StaticResource FieldLabel}" Margin="0"/>
                    <TextBlock x:Name="NameCounter"
                                   Text="0 / 20"
                                   Foreground="#555558"
                                   FontFamily="Segoe UI"
                                   FontSize="10"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"/>
                     </Grid>
                     <TextBox x:Name="NameBox"
                              Style="{StaticResource InputBox}"
                              MaxLength="20"
                             Margin="0,0,0,16"
                             TextChanged="NameBox_TextChanged"/>

                    <!-- Автор -->
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="АВТОР" Style="{StaticResource FieldLabel}" Margin="0"/>
                    <TextBlock x:Name="AuthorCounter"
                                   Text="0 / 10"
                                   Foreground="#555558"
                                   FontFamily="Segoe UI"
                                   FontSize="10"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"/>
                     </Grid>
                     <TextBox x:Name="AuthorBox"
                              Style="{StaticResource InputBox}"
                              MaxLength="10"
                             Margin="0,0,0,16"
                              TextChanged="AuthorBox_TextChanged"/>

                     <!-- Версия -->
                     <Grid Margin="0,0,0,6">
                         <TextBlock Text="ВЕРСИЯ" Style="{StaticResource FieldLabel}" Margin="0"/>
                     </Grid>
                     <TextBox x:Name="VersionBox"
                              Style="{StaticResource InputBox}"
                              MaxLength="4"
                              Margin="0,0,0,16"
                              PreviewTextInput="VersionBox_PreviewTextInput"
                              TextChanged="VersionBox_TextChanged"/>

                     <!-- Описание -->
                     <Grid Margin="0,0,0,6">
                         <TextBlock Text="ОПИСАНИЕ" Style="{StaticResource FieldLabel}" Margin="0"/>
                         <TextBlock x:Name="DescCounter"
                                   Text="0 / 100"
                                   Foreground="#555558"
                                   FontFamily="Segoe UI"
                                   FontSize="10"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"/>
                    </Grid>
                    <TextBox x:Name="DescBox"
                             Style="{StaticResource InputBox}"
                             MaxLength="100"
                             Height="66"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             Margin="0,0,0,20"
                             TextChanged="DescBox_TextChanged"/>

                    <!-- ═══ СТРАТЕГИЯ ═══ -->
                    <StackPanel x:Name="StrategySection" Visibility="Collapsed">
                        <TextBlock Text=".BAT ФАЙЛ СТРАТЕГИИ" Style="{StaticResource FieldLabel}"/>

                        <Border Background="#1a1a1c"
                                BorderBrush="#2a2a2d"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="BatPathDisplay"
                                               Text="Файл не выбран"
                                               FontFamily="Segoe UI"
                                               FontSize="12"
                                               Foreground="#555558"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="Выбрать"
                                        MinWidth="80" MinHeight="32"
                                        Style="{StaticResource OutlineBtn}"
                                        Margin="10,0,0,0"
                                        Click="SelectBat_Click"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Будет встроен в мод. Пользователи увидят предупреждение при импорте."
                                   Foreground="#555558"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,16"/>
                    </StackPanel>

                    <!-- ═══ СПИСОК ДОМЕНОВ ═══ -->
                    <StackPanel x:Name="ListSection" Visibility="Collapsed">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="ДОМЕНЫ" Style="{StaticResource FieldLabel}" Margin="0"/>
                            <TextBlock Text="по одному на строку"
                                       Foreground="#555558"
                                       FontFamily="Segoe UI"
                                       FontSize="10"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"/>
                        </Grid>
                        <TextBox x:Name="ListTextBox"
                                 Style="{StaticResource InputBox}"
                                 Height="100"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 FontFamily="Consolas"
                                 FontSize="12"/>
                        <TextBlock Text="Поддерживаются домены, IP-адреса и маски вида *.example.com"
                                   Foreground="#555558"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- ═══ FOOTER ═══ -->
            <Border Grid.Row="2" Background="#111113" CornerRadius="0,0,14,14"
                    BorderBrush="#22222a" BorderThickness="0,1,0,0"
                    Margin="0,16,0,0" Padding="28,12,28,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ValidationHint"
                               Grid.Column="0"
                               Visibility="Collapsed"
                               Foreground="#ef4444"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>

                    <Button Grid.Column="1" Content="Отмена"
                            MinWidth="100" MinHeight="36"
                            Style="{StaticResource OutlineBtn}"
                            Click="CancelBtn_Click"/>

                    <Button Grid.Column="3" Content="Создать мод"
                            MinWidth="130" MinHeight="36"
                            Style="{StaticResource AccentBtn}"
                            Click="CreateBtn_Click"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
